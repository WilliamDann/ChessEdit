{
  "name": "chessboard",
  "version": "1.0.0",
  "description": "Chessboard componoent using Chessground",
  "license": "ISC",
  "author": "William Dann",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch",
    "build": "tsc -p tsconfig.json && copyfiles -u 2 \"src/components/*.css\" dist/components && copyfiles -u 1 \"src/assets/**/*\" dist/assets",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.2.0",
    "chessops": "^0.15.1",
    "lucide-react": "^1.48.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
